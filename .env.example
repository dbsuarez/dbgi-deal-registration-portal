DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=registration.dbgi.ph
DJANGO_CSRF_TRUSTED_ORIGINS=https://registration.dbgi.ph
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
POSTGRES_DB=dbgi_portal
POSTGRES_USER=dbgi_portal
POSTGRES_PASSWORD=replace-with-a-unique-strong-password
DB_NAME=dbgi_portal
DB_USER=dbgi_portal
DB_PASSWORD=replace-with-a-unique-strong-password
DB_HOST=db
DB_PORT=5432
