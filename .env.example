DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=registration.dbgi.ph
DJANGO_CSRF_TRUSTED_ORIGINS=https://registration.dbgi.ph
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
DJANGO_THROTTLE_ENABLED=true
DJANGO_THROTTLE_FAIL_CLOSED=true
DJANGO_LOGIN_THROTTLE_LIMIT=10
DJANGO_LOGIN_THROTTLE_WINDOW_SECONDS=300
DJANGO_API_MUTATION_THROTTLE_LIMIT=120
DJANGO_API_MUTATION_THROTTLE_WINDOW_SECONDS=60
PORTAL_BASE_URL=https://registration.dbgi.ph
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=DBGI Support <support@dbgi.ph>
DJANGO_EMAIL_HOST=glacier.mxrouting.net
DJANGO_EMAIL_PORT=465
DJANGO_EMAIL_HOST_USER=support@dbgi.ph
DJANGO_EMAIL_HOST_PASSWORD=replace-with-smtp-password
DJANGO_EMAIL_USE_TLS=false
DJANGO_EMAIL_USE_SSL=true
DJANGO_EMAIL_TIMEOUT=10
POSTGRES_DB=dbgi_portal
POSTGRES_USER=dbgi_portal
POSTGRES_PASSWORD=replace-with-a-unique-strong-password
DB_NAME=dbgi_portal
DB_USER=dbgi_portal
DB_PASSWORD=replace-with-a-unique-strong-password
DB_HOST=db
DB_PORT=5432
